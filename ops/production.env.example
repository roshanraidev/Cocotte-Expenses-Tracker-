# Names/placeholders only. Configure actual secrets in the hosting secret manager.
# Web + worker: TLS-enabled managed PostgreSQL URL. Never point previews at production.
DATABASE_URL=
# Web + worker: securely transfer the EXISTING 32-byte base64 key; do not replace it.
ZONAL_CREDENTIALS_KEY=
NODE_ENV=production
# Per process, within the provider's total connection allowance.
DATABASE_POOL_SIZE=5
ZONAL_SALES_RECHECK_DAYS=7
# Optional build-time key for multiple web instances; distinct from the Zonal key.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Set by the worker image, not normally needed in the Vercel web environment.
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# No NEXTAUTH_SECRET/AUTH_URL required: existing authentication uses database sessions.
# Legacy ZONAL_USERNAME/ZONAL_PASSWORD variables are unnecessary for restored encrypted connections.
# Do not set seed administrator passwords or run db:seed against restored data.
