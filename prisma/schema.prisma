generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHEF
  SUPER_USER
}

enum AccessRole {
  SUPER_USER
  ADMINISTRATOR
  MANAGER
  HEAD_CHEF
  SOUS_CHEF
  KITCHEN_STAFF
  VIEWER
}

enum OrderStatus {
  DRAFT
  PLACED
  RECEIVED
  CANCELLED
}

enum StockStatus {
  DRAFT
  CONFIRMED
}

enum AdjustmentKind {
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  CORRECTION
}

model Restaurant {
 kitchenEvents KitchenEvent[]
 kitchenAnnouncements KitchenAnnouncement[]
 salesJobs ZonalSalesJob[]
 zonalDeliveryPreviews ZonalDeliveryPreview[]
 zonalDeliveryImports ZonalDeliveryImport[]

  id          String              @id @default("restaurant")
  name        String
  currency    String              @default("GBP")
  timezone    String              @default("Europe/London")
  createdAt   DateTime            @default(now())
  rolePolicies AccessRolePolicy[]
  targets     WeeklyTarget[]
  defaults    TargetDefault[]
  settings    RestaurantSettings?
  users       User[]
  weeks       WeeklyForecast[]
  sales       DailySales[]
  suppliers   Supplier[]
  products    Product[]
  orders      SupplierOrder[]
  invoices    PurchaseInvoice[]
  stockCounts StockCount[]
  adjustments StockAdjustment[]
  auditLogs   AuditLog[]
  packagingInvoices PackagingInvoice[]
  packagingProducts PackagingProduct[]
  recipeTypes RecipeType[]
  recipes Recipe[]
  recipeFeatures RecipeFeatureSettings?
  recipeLibraryDefault RestaurantRecipeLibrary?
  recipeLibraries UserRecipeLibrary[]
  zonalSyncBatches ZonalSyncBatch[]
  foodCostPeriods FoodCostPeriod[]
  foodCostPreviews FoodCostPreview[]
  zonalConnection ZonalConnection?
  zonalAgentOutbox ZonalAgentOutbox[]
  zonalAgentReceipts ZonalAgentReceipt[]
  zonalImports ZonalImport[]
}

model RestaurantSettings {
  restaurantId   String     @id
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  targetBps      Int        @default(2400)
  warningBps     Int        @default(2200)
  allocationDays Int        @default(1)
  updatedAt      DateTime   @updatedAt
}

model User {
 kitchenReads KitchenRead[]
 kitchenPreference KitchenPreference?
 kitchenSubscriptions KitchenPushSubscription[]
 kitchenAnnouncements KitchenAnnouncement[]
 salesJobs ZonalSalesJob[]
 zonalDeliveryPreviews ZonalDeliveryPreview[]
 zonalDeliveryImports ZonalDeliveryImport[]

  id           String     @id @default(cuid())
  restaurantId String     @default("restaurant")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CHEF)
  accessRole AccessRole?
  permissionOverrides Json?
  lastLoginAt DateTime?
  passwordResets PasswordReset[]
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  zonalImports ZonalImport[]
  zonalSyncBatches ZonalSyncBatch[]
  foodCostApprovals FoodCostPeriod[]
  foodCostPreviews FoodCostPreview[]
  sessions     Session[]
  auditLogs    AuditLog[]

  recipeLibrary UserRecipeLibrary?
  @@unique([id, restaurantId])
  @@index([restaurantId, active])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Persistent account-based throttling; keys are hashes of normalized email addresses.
model LoginThrottle {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
}

model WeeklyForecast {
  version                    Int           @default(1)
  id                         String        @id @default(cuid())
  restaurantId               String        @default("restaurant")
  restaurant                 Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  weekStart                  DateTime      @db.Date
  targetBps                  Int
  warningBps                 Int
  // Explicit nullable assumptions: null means unknown, never zero or opening stock.
  openingStockPence          BigInt?
  actualClosingStockPence BigInt?
  expectedClosingStockPence  BigInt?
  nextDeliveryDate           DateTime? @db.Date
  followingDeliveryDate      DateTime? @db.Date
  stockAvailabilityConfirmed Boolean       @default(false)
  allocationDays             Int           @default(1)
  purchasesConfirmedAt       DateTime?
  finalizedAt                DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  days                       ForecastDay[]

  @@unique([restaurantId, weekStart])
}

model ForecastDay {
  id                    String         @id @default(cuid())
  weeklyForecastId      String
  weeklyForecast        WeeklyForecast @relation(fields: [weeklyForecastId], references: [id], onDelete: Restrict)
  date                  DateTime       @db.Date
  originalForecastPence BigInt
  forecastPence         BigInt

  @@unique([weeklyForecastId, date])
}

model DailySales {
  version      Int        @default(1)
  id           String     @id @default(cuid())
  restaurantId String     @default("restaurant")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  date         DateTime   @db.Date
  amountPence  BigInt
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, date])
}

model Supplier {
 zonalDeliveryImports ZonalDeliveryImport[]

  id               String            @id @default(cuid())
  restaurantId     String            @default("restaurant")
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  name             String
  contact          String?
  email            String?
  phone            String?
  deliverySchedule String?
  active           Boolean           @default(true)
  foodWorkspace    Boolean           @default(true)
  packagingWorkspace Boolean         @default(false)
  packagingInvoices PackagingInvoice[]
  packagingAliases PackagingAlias[]
  products         Product[]
  orders           SupplierOrder[]
  invoices         PurchaseInvoice[]

  @@unique([restaurantId, name])
}

model Product {
  id           String              @id @default(cuid())
  restaurantId String              @default("restaurant")
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  name         String
  category     String
  countingUnit String
  // Decimal unit costs support prices quoted below one penny per unit.
  unitCost     Decimal             @db.Decimal(14, 4)
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  active       Boolean             @default(true)
  orderItems   SupplierOrderItem[]
  countItems   StockCountItem[]
  adjustments  StockAdjustment[]

  @@index([restaurantId, active])
}

model SupplierOrder {
  id                   String              @id @default(cuid())
  restaurantId         String              @default("restaurant")
  restaurant           Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderDate            DateTime            @db.Date
  expectedDeliveryDate DateTime            @db.Date
  receivedDate         DateTime?           @db.Date
  estimatedAmountPence BigInt
  status               OrderStatus         @default(DRAFT)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  items                SupplierOrderItem[]
  // One current invoice per order; corrections update it with an audit entry.
  invoice              PurchaseInvoice?

  @@index([restaurantId, expectedDeliveryDate, status])
}

model SupplierOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal       @db.Decimal(14, 4)
  unitCost       Decimal       @db.Decimal(14, 4)
  lineTotalPence BigInt

  @@unique([orderId, productId])
}

model PurchaseInvoice {
 zonalDeliveryImport ZonalDeliveryImport?

  id             String            @id @default(cuid())
  restaurantId   String            @default("restaurant")
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderId        String?           @unique
  order          SupplierOrder?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reference      String
  // Browser submission key is stored server-side to make retries idempotent.
  submissionKey  String?           @unique
  orderDate      DateTime?         @db.Date
  accountingDate DateTime          @db.Date
  amountPence    BigInt
  // Credits are separate negative invoices linked to the original invoice.
  creditForId    String?
  creditFor      PurchaseInvoice?  @relation("Credits", fields: [creditForId], references: [id], onDelete: Restrict)
  credits        PurchaseInvoice[] @relation("Credits")
  confirmedAt    DateTime?
  voidedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([supplierId, reference])
  @@index([restaurantId, accountingDate])
}

model StockCount {
  id              String           @id @default(cuid())
  restaurantId    String           @default("restaurant")
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  date            DateTime         @db.Date
  status          StockStatus      @default(DRAFT)
  totalValuePence BigInt?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           StockCountItem[]

  @@unique([restaurantId, date])
}

model StockCountItem {
  id           String     @id @default(cuid())
  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Restrict)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName  String
  countingUnit String
  quantity     Decimal    @db.Decimal(14, 4)
  unitCost     Decimal    @db.Decimal(14, 4)
  valuePence   BigInt

  @@unique([stockCountId, productId])
}

model StockAdjustment {
  id             String         @id @default(cuid())
  restaurantId   String         @default("restaurant")
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  accountingDate DateTime       @db.Date
  kind           AdjustmentKind
  valuePence     BigInt
  reason         String
  // Explanatory movements; accounting treatment must be decided before implementation.
  createdAt      DateTime       @default(now())

  @@index([restaurantId, accountingDate])
}

model AuditLog {
  id           String     @id @default(cuid())
  restaurantId String     @default("restaurant")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  actorId      String?
  actor        User?      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action       String
  entity       String
  entityId     String
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
  @@index([entity, entityId])
}

// Independent from forecasts so targets can be scheduled before sales planning.
model WeeklyTarget {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  weekStart DateTime @db.Date
  originalBps Int
  targetBps Int
  source String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([restaurantId, weekStart])
}

// Effective-dated defaults preserve inheritance even for weeks never opened in the UI.
model TargetDefault {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime @db.Date
  targetBps Int
  createdAt DateTime @default(now())
  @@index([restaurantId, effectiveFrom, createdAt])
}


enum PackagingCategory {
  UNCLASSIFIED
  PACKAGING
  CHEMICAL
}

enum PackagingInvoiceStatus {
  REVIEW
  CONFIRMED
  VOIDED
}

model PackagingProduct {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields:[restaurantId], references:[id], onDelete:Restrict)
  name String
  nameKey String
  category PackagingCategory
  unit String @default("")
  packSize String @default("")
  verified Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aliases PackagingAlias[]
  lines PackagingLine[]
  @@unique([restaurantId,nameKey,unit,packSize,category])
}

model PackagingAlias {
  id String @id @default(cuid())
  supplierId String
  supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Restrict)
  productId String
  product PackagingProduct @relation(fields:[productId],references:[id],onDelete:Restrict)
  description String
  descriptionKey String
  unit String @default("")
  packSize String @default("")
  createdAt DateTime @default(now())
  @@unique([supplierId,descriptionKey,unit,packSize])
}

model PackagingInvoice {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
  supplierId String?
  supplier Supplier? @relation(fields:[supplierId],references:[id],onDelete:Restrict)
  submissionKey String @unique
  orderDate DateTime? @db.Date
  deliveryDate DateTime? @db.Date
  invoiceDate DateTime? @db.Date
  orderNumber String?
  invoiceNumber String?
  numberKey String?
  status PackagingInvoiceStatus @default(REVIEW)
  netPence BigInt?
  vatPence BigInt?
  grossPence BigInt?
  extractedText String @default("")
  extraction Json?
  review Json?
  scanNote String @default("")
  reviewReason String?
  version Int @default(1)
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  document PackagingDocument?
  lines PackagingLine[]
  @@unique([supplierId,numberKey])
  @@index([restaurantId,deliveryDate,status])
}

// BYTEA is persistent server storage, included in PostgreSQL backups; never a public URL.
model PackagingDocument {
  id String @id @default(cuid())
  invoiceId String @unique
  invoice PackagingInvoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  filename String
  mime String
  size Int
  sha256 String
  bytes Bytes
  createdAt DateTime @default(now())
  @@index([sha256])
}

model PackagingLine {
  id String @id @default(cuid())
  invoiceId String
  invoice PackagingInvoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  productId String
  product PackagingProduct @relation(fields:[productId],references:[id],onDelete:Restrict)
  originalDescription String
  category PackagingCategory
  unit String @default("")
  packSize String @default("")
  quantity Decimal? @db.Decimal(14,4)
  priceBasis String @default("INVOICE")
  unitPrice Decimal? @db.Decimal(14,4)
  netPence BigInt
  position Int
  @@unique([invoiceId,position])
}


model RecipeType {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  name String
  visible Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipes Recipe[]
  @@unique([restaurantId, name])
  @@index([restaurantId, visible, sortOrder])
}

model Recipe {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  typeId String
  type RecipeType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  name String
  visible Boolean @default(true)
  archivedAt DateTime?
  sortOrder Int @default(0)
  imageMime String?
  imageBytes Bytes?
  ingredients Json
  beforeService String @default("")
  onOrder String @default("")
  allergens String @default("")
  mayContain String @default("")
  suitability String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  specials WeeklySpecial[]
  components RecipeComponent[] @relation("RecipeComponents")
  usedIn RecipeComponent[] @relation("ComponentRecipes")
  @@unique([id, restaurantId])
  @@unique([restaurantId, typeId, name])
  @@index([restaurantId, visible, typeId, sortOrder])
  @@index([restaurantId, archivedAt, typeId, sortOrder])
}


model RecipeFeatureSettings {
  restaurantId String @id
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  weeklySpecialsEnabled Boolean @default(false)
}

enum WeeklySpecialStatus {
  DRAFT
  PUBLISHED
}

model WeeklySpecial {
  id String @id @default(cuid())
  restaurantId String
  recipeId String
  recipe Recipe @relation(fields: [recipeId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  status WeeklySpecialStatus @default(DRAFT)
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([restaurantId, status])
}

model RecipeComponent {
  restaurantId String
  recipeId String
  componentId String
  recipe Recipe @relation("RecipeComponents", fields: [recipeId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  component Recipe @relation("ComponentRecipes", fields: [componentId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  position Int @default(0)
  @@id([recipeId, componentId])
  @@index([restaurantId, recipeId, position])
  @@index([componentId])
}

// Daily-sales-only pilot; credentials are never stored here.
model ZonalImport {
  agentReceipts ZonalAgentReceipt[]
  syncDays ZonalSyncDay[]
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  date DateTime @db.Date
  branch String
  source String
  status String @default("PREVIEW")
  payload Json
  fingerprint String
  salesVersion Int
  previousPence BigInt?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([restaurantId, createdAt])
  @@index([restaurantId, date, fingerprint])
}

// One encrypted connection per restaurant. Disconnect removes the envelope;
// the row retains revision/cooldown metadata to invalidate in-flight checks.
model ZonalConnection {
  restaurantId String @id
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch String
  encryptedCredentials String?
  revision Int @default(1)
  loginVerifiedAt DateTime?
  reportAccessVerifiedAt DateTime?
  lastAttemptAt DateTime?
  lastResultCode String?
  updatedAt DateTime @updatedAt
}

// Manual batch jobs only; credentials/report bodies are never duplicated here.
model ZonalSyncBatch {
  id String @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
  actorId String
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  branch String
  from DateTime @db.Date
  to DateTime @db.Date
  status String @default("RUNNING")
  connectionRevision Int
  heartbeatAt DateTime @default(now())
  createdAt DateTime @default(now())
  finishedAt DateTime?
  days ZonalSyncDay[]
  @@index([restaurantId,createdAt])
}

model ZonalSyncDay {
  id String @id @default(cuid())
  batchId String
  batch ZonalSyncBatch @relation(fields:[batchId],references:[id],onDelete:Restrict)
  date DateTime @db.Date
  status String @default("PENDING")
  attempted Boolean @default(false)
  errorCode String?
  approvalError String?
  previewId String?
  preview ZonalImport? @relation(fields:[previewId],references:[id],onDelete:Restrict)
  checkedAt DateTime?
  @@unique([batchId,date])
}

// Separate reporting ledger. Never feeds purchasing allowance.
model FoodCostPeriod {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
 from DateTime @db.Date
 to DateTime @db.Date
 category String @default("FOOD")
 payload Json
 fingerprint String
 version Int @default(1)
 approvedById String
 approvedBy User @relation(fields:[approvedById],references:[id],onDelete:Restrict)
 approvedAt DateTime @default(now())
 previews FoodCostPreview[]
 @@unique([restaurantId,from,to,category])
}
model FoodCostPreview {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
 actorId String
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 from DateTime @db.Date
 to DateTime @db.Date
 category String @default("FOOD")
 payload Json
 fingerprint String
 expectedVersion Int
 status String @default("PREVIEW")
 createdAt DateTime @default(now())
 completedAt DateTime?
 periodId String?
 period FoodCostPeriod? @relation(fields:[periodId],references:[id],onDelete:Restrict)
 @@index([restaurantId,createdAt])
}

model ZonalDeliveryPreview {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 actorId String
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 from DateTime @db.Date
 to DateTime @db.Date
 connectionRevision Int
 payload Json
 createdAt DateTime @default(now())
 expiresAt DateTime
 status String @default("PREVIEW")
 result Json?
 @@index([restaurantId,createdAt])
}
model ZonalDeliveryImport {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 supplierId String
 supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 purchaseId String @unique
 purchase PurchaseInvoice @relation(fields:[purchaseId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 actorId String
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 location String
 deliveryId String
 documentKey String
 fingerprint String
 createdAt DateTime @default(now())
 @@unique([restaurantId,location,deliveryId])
 @@unique([restaurantId,supplierId,documentKey])
}

model AccessRolePolicy {
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
 role AccessRole
 permissions Json
 updatedAt DateTime @updatedAt
 @@id([restaurantId,role])
}
model PasswordReset {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 tokenHash String @unique
 expiresAt DateTime
 consumedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId,expiresAt])
}

// PostgreSQL-backed, manually requested sales work. No credentials are stored here.
model ZonalSalesJob {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
 actorId String
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 kind String
 phase String @default("FETCH")
 status String @default("QUEUED")
 from DateTime @db.Date
 to DateTime @db.Date
 latestAvailable DateTime? @db.Date
 leaseToken String?
 leaseUntil DateTime?
 activeBatchId String?
 approvalReason String?
 lastError String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 days ZonalSalesJobDay[]
 @@index([status,leaseUntil])
 @@index([restaurantId,createdAt])
}
model ZonalSalesJobDay {
 id String @id @default(cuid())
 jobId String
 job ZonalSalesJob @relation(fields:[jobId],references:[id],onDelete:Restrict)
 date DateTime @db.Date
 status String @default("PENDING")
 previewId String?
 fingerprint String?
 reason String?
 processedAt DateTime?
 @@unique([jobId,date])
 @@index([previewId])
}
model ZonalSalesWorker {
 id String @id
 heartbeatAt DateTime @default(now())
}

// Local Mac only. Immutable validated reports; no authentication material.
model ZonalAgentOutbox {
 id String @id @default(uuid())
 sequence BigInt @unique @default(autoincrement())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
 agentId String
 date DateTime @db.Date
 capturedAt DateTime
 payload Json
 status String @default("PENDING")
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 leaseToken String?
 leaseUntil DateTime?
 lastError String?
 receipt Json?
 createdAt DateTime @default(now())
 acknowledgedAt DateTime?
 @@index([agentId,status,nextAttemptAt])
}

// Production receipt and preview commit together. Retries never renew freshness.
model ZonalAgentReceipt {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Restrict)
 agentId String
 transferId String
 sequence BigInt
 date DateTime @db.Date
 capturedAt DateTime
 bodyHash String
 fingerprint String
 status String
 previewId String?
 preview ZonalImport? @relation(fields:[previewId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 @@unique([agentId,transferId])
 @@unique([agentId,sequence])
 @@index([restaurantId,agentId,date,sequence])
 @@index([agentId,createdAt])
}

// Display preferences only; recipe records, costing and historical references are untouched.
model RestaurantRecipeLibrary {
  restaurantId String @id
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  recipeIds String[] @default([])
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}

model UserRecipeLibrary {
  userId String @id
  restaurantId String
  user User @relation(fields: [userId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  personalOrder Json?
  filters Json @default("{}")
  orderRevision Int @default(0)
  filtersRevision Int @default(0)
  updatedAt DateTime @updatedAt
  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

// Kitchen events are immutable; source IDs deliberately survive source removal.
model KitchenEvent {
 restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
 reads KitchenRead[]
 deliveries KitchenPushDelivery[]
 id String @id
 restaurantId String
 category String
 action String
 recipeId String?
 announcementId String?
 createdAt DateTime @default(now()) @db.Timestamptz
 fanoutAt DateTime? @db.Timestamptz
 @@index([restaurantId, createdAt(sort: Desc)], map: "KitchenEvent_restaurant_created")
}
model KitchenRead {
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 event KitchenEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
 userId String
 eventId String
 readAt DateTime? @db.Timestamptz
 @@id([userId, eventId])
}
model KitchenPreference {
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 userId String @id
 inApp Json @default("{}")
 push Json @default("{}")
 pushEnabled Boolean @default(false)
}
model KitchenAnnouncement {
 restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
 author User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
 id String @id
 restaurantId String
 title String
 body String
 published Boolean @default(true)
 createdBy String
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @default(now()) @db.Timestamptz
}
model KitchenPushSubscription {
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 deliveries KitchenPushDelivery[]
 id String @id
 userId String
 endpointHash String @unique
 ciphertext String
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([userId])
}
model KitchenPushDelivery {
 event KitchenEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
 subscription KitchenPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
 eventId String
 subscriptionId String
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now()) @db.Timestamptz
 leaseUntil DateTime? @db.Timestamptz
 leaseToken String?
 sentAt DateTime? @db.Timestamptz
 failed Boolean @default(false)
 @@id([eventId, subscriptionId])
}
